                  "registries": [
                    {
                      "server": "[parameters('registryLoginServer')]",
                      "username": "[parameters('registryUsername')]",
                      "passwordSecretRef": "registry-password"
                    }
                  ],
                  "secrets": "[variables('commonSecrets')]"
                },
                "template": {
                  "containers": [
                    {
                      "name": "worker",
                      "image": "[variables('placeholderImage')]",
                      "env": "[union(variables('commonEnv'), createArray(createObject('name', 'WORKER_MODE', 'value', 'true')))]",
                      "resources": {
                        "cpu": "[json('1.0')]",
                        "memory": "2Gi"
                      }
                    }
                  ],
                  "scale": {
                    "minReplicas": 1,
                    "maxReplicas": 1
                  }
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.App/managedEnvironments', variables('envName'))]"
              ]
            }
          ],
          "outputs": {
            "apiUrl": {
              "type": "string",
              "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', variables('apiAppName')), '2024-03-01').configuration.ingress.fqdn)]"
            },
            "apiAppName": {
              "type": "string",
              "value": "[variables('apiAppName')]"
            },
            "workerAppName": {
              "type": "string",
              "value": "[variables('workerAppName')]"
            },
            "environmentName": {
              "type": "string",
              "value": "[variables('envName')]"
            }
          }
        }
      },
      "dependsOn": [
        "database",
        "identity",
        "registry",
        "rg",
        "storage"
      ]
    }
  },
  "outputs": {
    "appUrl": {
      "type": "string",
      "metadata": {
        "description": "URL of the deployed APhoto web app."
      },
      "value": "[format('https://{0}', reference('staticWebApp').outputs.defaultHostname.value)]"
    },
    "apiUrl": {
      "type": "string",
      "metadata": {
        "description": "API URL — set this as VITE_API_URL when building the frontend."
      },
      "value": "[reference('containerApps').outputs.apiUrl.value]"
    },
    "resourceGroupName": {
      "type": "string",
      "metadata": {
        "description": "Resource group name."
      },
      "value": "[format('{0}-rg', parameters('appName'))]"
    },
    "registryLoginServer": {
      "type": "string",
      "metadata": {
        "description": "Container Registry login server."
      },
      "value": "[reference('registry').outputs.loginServer.value]"
    },
    "apiAppName": {
      "type": "string",
      "metadata": {
        "description": "API Container App name (for CI updates)."
      },
      "value": "[reference('containerApps').outputs.apiAppName.value]"
    },
    "workerAppName": {
      "type": "string",
      "metadata": {
        "description": "Worker Container App name (for CI updates)."
      },
      "value": "[reference('containerApps').outputs.workerAppName.value]"
    },
    "swaDeploymentToken": {
      "type": "string",
      "metadata": {
        "description": "Static Web App deployment token — use in GitHub Actions."
      },
      "value": "[reference('staticWebApp').outputs.deploymentToken.value]"
    }
  }
}